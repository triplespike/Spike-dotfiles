config-file = ?theme.conf
font-family = JetBrainsMono Nerd Font
window-width = 96
window-height = 25
window-save-state = never
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
window-decoration = false
background = 080B16
foreground = E8EDFF
background-opacity = 0.76
background-blur-radius = 20
palette = 0=#080B16
palette = 1=#FD4663
palette = 2=#678FE4
palette = 3=#E0AF68
palette = 4=#678FE4
palette = 5=#AB66CC
palette = 6=#82B8E8
palette = 7=#E8EDFF
palette = 8=#46516F
palette = 9=#FF6B8B
palette = 10=#7DCFFF
palette = 11=#F1F3FF
palette = 12=#829AFF
palette = 13=#C77DFF
palette = 14=#AED8FF
palette = 15=#FFFFFF
cursor-color = #A8B7FF
selection-background = #344879
selection-foreground = #FFFFFF
command = fish
keybind = shift+insert=paste_from_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+,=unbind
clipboard-read = allow
clipboard-paste-protection = false
