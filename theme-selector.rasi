configuration {
    modi: "dmenu";
    show-icons: true;
    font: "JetBrainsMono Nerd Font 10";
}

/* Fallback defaults (Nullscapes) before dynamic @import */
* {
    bg-base:      #080B16DE;
    bg-surface:   #141B29E6;
    bg-card:      #1B2437B8;
    bg-selected:  #3D5994F2;
    border-col:   #454F6B88;
    border-focus: #678FE4;
    fg-main:      #E8EDFF;
    fg-sub:       #AFB1B6;
    accent:       #678FE4;
    accent-alt:   #AB66CC;

    background-color: transparent;
    text-color:       @fg-main;
}

@import "~/.config/rofi/theme-colors.rasi"

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            82%;
    border:           2px;
    border-color:     @border-focus;
    border-radius:    20px;
    background-color: @bg-base;
    padding:          20px;
}

mainbox {
    spacing:          16px;
    children:         [ inputbar, listview, message ];
}

inputbar {
    spacing:          12px;
    padding:          10px 16px;
    border:           1px;
    border-color:     @border-col;
    border-radius:    12px;
    background-color: @bg-surface;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:       "Поиск темы...";
    placeholder-color: @fg-sub;
    text-color:        @fg-main;
}

listview {
    layout:        horizontal;
    lines:         5;
    fixed-columns: true;
    spacing:       14px;
    cycle:         true;
    dynamic:       false;
    scrollbar:     false;
}

element {
    orientation:      vertical;
    spacing:          6px;
    padding:          12px 10px 14px 10px;
    border:           1px;
    border-color:     @border-col;
    border-radius:    16px;
    background-color: @bg-card;
    cursor:           pointer;
}

element-icon {
    size:             220px;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    cursor:           pointer;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
    text-color:       inherit;
    font:             "JetBrainsMono Nerd Font SemiBold 10";
    cursor:           pointer;
}

element selected.normal {
    background-color: @bg-selected;
    border:           2px;
    border-color:     @border-focus;
    text-color:       #FFFFFF;
}

element normal.active {
    border:           2px;
    border-color:     @accent-alt;
    background-color: @bg-surface;
    text-color:       @accent-alt;
}

element selected.active {
    background-color: @bg-selected;
    border:           2px;
    border-color:     @accent-alt;
    text-color:       #FFFFFF;
}

message {
    padding:          2px 0px 0px 0px;
    border:           0px;
}

textbox {
    horizontal-align: 0.5;
    text-color:       @fg-sub;
    font:             "JetBrainsMono Nerd Font 9";
}
