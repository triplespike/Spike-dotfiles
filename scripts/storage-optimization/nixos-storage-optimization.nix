# ==============================================================================
# nixos-storage-optimization.nix - Декларативная оптимизация хранилища NixOS
# ==============================================================================
# Данный модуль автоматизирует управление жизненным циклом пакетов и поколений
# системы в /nix/store и меню загрузчика GRUB EFI.
#
# Инструкция по подключению:
# 1. Поместите или импортируйте этот файл в /etc/nixos/configuration.nix:
#    imports = [
#      ./hardware-configuration.nix
#      /home/spike/Spike-dotfiles/scripts/storage-optimization/nixos-storage-optimization.nix
#    ];
#
# 2. Или скопируйте его содержимое в блок конфигурации /etc/nixos/configuration.nix.
#
# 3. Примените конфигурацию:
#    nh os switch /etc/nixos  (или: sudo nixos-rebuild switch --flake /etc/nixos#default)
# ==============================================================================

{ config, pkgs, lib, ... }:

{
  # ----------------------------------------------------------------------------
  # 1. Ограничение количества хранимых поколений системы в загрузчике GRUB
  # ----------------------------------------------------------------------------
  # Внимание: В данной системе используется GRUB EFI (boot.loader.grub.enable = true),
  # а не systemd-boot. Поэтому параметр задается строго для GRUB.
  # Ограничение до 5 поколений предотвращает переполнение меню и предотвращает
  # удержание старых версий ядер и зависимостей в /nix/store как GC-корней.
  boot.loader.grub.configurationLimit = 5;

  # ----------------------------------------------------------------------------
  # 2. Автоматический сбор мусора (Garbage Collection) в /nix/store
  # ----------------------------------------------------------------------------
  # Автоматически удаляет поколения и недостижимые пути старше 7 дней раз в неделю.
  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 7d";
  };

  # ----------------------------------------------------------------------------
  # 3. Автоматическая еженедельная дедупликация жесткими ссылками
  # ----------------------------------------------------------------------------
  # Объединяет идентичные файлы в /nix/store/.links, экономя ~8-10 ГБ на Btrfs.
  nix.optimise = {
    automatic = true;
    dates = [ "weekly" ];
  };

  # ----------------------------------------------------------------------------
  # 4. Необходимые утилиты для обслуживания файловых систем
  # ----------------------------------------------------------------------------
  environment.systemPackages = with pkgs; [
    cloud-utils    # growpart для расширения разделов GPT
    gptfdisk       # sgdisk / gdisk для обслуживания таблиц GPT
    e2fsprogs      # resize2fs, tune2fs, dumpe2fs
    btrfs-progs    # утилиты инспекции Btrfs
    nh             # Nix CLI Helper для удобной очистки: nh clean user
  ];
}
